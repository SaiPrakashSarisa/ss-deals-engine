{
  "name": "@ss-deals/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @ss-deals/core build",
    "dev": "next dev --hostname 0.0.0.0 --port 3001",
    "prebuild": "pnpm --filter @ss-deals/core build",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3001",
    "pretest": "pnpm --filter @ss-deals/core build",
    "test": "vitest run --reporter=verbose",
    "pretypecheck": "pnpm --filter @ss-deals/core build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ss-deals/core": "workspace:*",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
