{
  "name": "@ss-deals/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "predev": "pnpm --filter @ss-deals/core build",
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/api/main.ts",
    "dev:worker": "node --env-file-if-exists=../../.env --import tsx --watch src/worker/main.ts",
    "prebuild": "pnpm --filter @ss-deals/core build",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/api/main.js",
    "start:worker": "node dist/worker/main.js",
    "pretest": "pnpm --filter @ss-deals/core build",
    "test": "vitest run --reporter=verbose",
    "pretypecheck": "pnpm --filter @ss-deals/core build",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env --import tsx src/scripts/migrate.ts",
    "user:create": "node --env-file-if-exists=../../.env --import tsx src/scripts/user-admin.ts create",
    "user:set-password": "node --env-file-if-exists=../../.env --import tsx src/scripts/user-admin.ts set-password",
    "user:set-name": "node --env-file-if-exists=../../.env --import tsx src/scripts/user-admin.ts set-name",
    "user:deactivate": "node --env-file-if-exists=../../.env --import tsx src/scripts/user-admin.ts deactivate"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.6",
    "@ss-deals/core": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
