{
  "name": "@ss-deals/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/api/main.ts",
    "dev:worker": "node --env-file-if-exists=../../.env --import tsx --watch src/worker/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/api/main.js",
    "start:worker": "node dist/worker/main.js",
    "test": "vitest run --reporter=verbose",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env --import tsx src/scripts/migrate.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
