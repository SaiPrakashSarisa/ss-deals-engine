NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://ssdeals:ssdeals@127.0.0.1:5432/ssdeals
LOG_LEVEL=info
TZ=Asia/Kolkata

# Integration tests run only when this is set. Point it at a disposable database.
# TEST_DATABASE_URL=postgres://ssdeals:ssdeals@127.0.0.1:5432/ssdeals

# Production Compose refuses to start until both of these are set.
# The URL must use the hostname `postgres` (the Compose service), not 127.0.0.1.
# POSTGRES_PASSWORD=replace-me
# COMPOSE_DATABASE_URL=postgres://ssdeals:replace-me@postgres:5432/ssdeals

# Quick-post bot (apps/quickpost). The API and worker ignore these.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHANNEL=@ss_super_deals
# OWNER_TELEGRAM_ID=
# AMAZON_TAG=
# DAILY_POST_LIMIT=8
# DATA_DIR=./data
# Comma-separated hosts allowed on an optional short: line.
# SHORT_LINK_HOSTS=amzn.to,link.amazon
# Channel link presentation: text, button, or both.
# LINK_STYLE=text
# Optional italic line at the end of each post. Empty adds nothing. Max 120 characters.
# POST_FOOTER=

# Web sign-in. The API reads these. Defaults match http://localhost:3001.
# SESSION_COOKIE_NAME=ssd_session
# COOKIE_SECURE=false
# ALLOWED_ORIGIN=http://localhost:3001

# The Next.js server calls the API at this URL. The browser stays on port 3001.
# API_URL=http://127.0.0.1:3000
# Compose publishes the web app on this address. 127.0.0.1 keeps it on this machine.
# WEB_BIND=127.0.0.1
